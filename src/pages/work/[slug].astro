---
import { getCollection, render } from 'astro:content';
import CaseStudy from '../../layouts/CaseStudy.astro';
import Figure from '../../components/Figure.astro';
import CodeRef from '../../components/CodeRef.astro';

export async function getStaticPaths() {
  const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
  return work.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, next: work[(i + 1) % work.length] },
  }));
}

const { entry, next } = Astro.props;
const { Content, headings } = await render(entry);
---

<CaseStudy entry={entry} next={next} headings={headings}>
  <Content components={{ Figure, CodeRef }} />
</CaseStudy>
