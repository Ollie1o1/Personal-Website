---
interface Props {
  caption: string;
  label?: string;
}
const { caption, label = 'fig.' } = Astro.props;
---

<figure class="fig">
  <div class="canvas"><slot /></div>
  <figcaption class="mono"><span>{label}</span> {caption}</figcaption>
</figure>

<style>
  .fig { margin: 24px 0 28px; }
  .canvas {
    padding: clamp(16px, 3vw, 28px);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--panel);
    overflow-x: auto;
  }
  .canvas :global(svg) { width: 100%; height: auto; min-width: 520px; }
  /* Diagram vocabulary for inline SVGs written in MDX */
  .canvas :global(svg) { font-family: var(--font-mono); font-size: 11px; }
  .canvas :global(.box) { fill: var(--bg); stroke: var(--line); }
  .canvas :global(.box-strong) { fill: var(--bg); stroke: var(--mute); }
  .canvas :global(.box-accent) { fill: var(--bg); stroke: var(--amber); }
  .canvas :global(.t) { fill: var(--fg); }
  .canvas :global(.td) { fill: var(--dim); font-size: 10px; }
  .canvas :global(.ta) { fill: var(--amber); font-size: 10px; }
  .canvas :global(.edge) { fill: none; stroke: var(--faint); }
  .canvas :global(.edge-accent) { fill: none; stroke: var(--amber); stroke-dasharray: 3 4; }
  .canvas :global(.arrow) { fill: none; stroke: var(--faint); }
  .canvas :global(.group) { fill: none; stroke: var(--line); stroke-dasharray: 2 3; }
  figcaption { margin-top: 10px; font-size: 11px; color: var(--dim); }
  figcaption span { color: var(--mute); }
</style>
