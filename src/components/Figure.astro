---
interface Props {
  caption: string;
  label?: string;
}
const { caption, label = 'fig.' } = Astro.props;
---

<figure class="fig">
  <div class="canvas"><slot /></div>
  <figcaption class="mono"><span>{label}</span> {caption}</figcaption>
</figure>

<style>
  .fig { margin: 24px 0 28px; }
  .canvas {
    padding: clamp(16px, 3vw, 28px);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--panel);
    overflow-x: auto;
  }
  .canvas :global(svg) { width: 100%; height: auto; min-width: 520px; }
  figcaption { margin-top: 10px; font-size: 11px; color: var(--dim); }
  figcaption span { color: var(--mute); }
</style>
