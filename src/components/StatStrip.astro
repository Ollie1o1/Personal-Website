---
import type { Stat } from '../lib/schema';

interface Props {
  stats: Stat[];
}
const { stats } = Astro.props;
const notes = stats.filter((s) => s.note);
---

<div class="strip-wrap">
  <dl class="strip">
    {
      stats.map((s) => (
        <div>
          <dt class="label">
            {s.k}
            {s.note && <span aria-hidden="true">*</span>}
          </dt>
          <dd class:list={['metric', { accent: s.accent }]} data-count>
            {s.v}
          </dd>
        </div>
      ))
    }
  </dl>
  {notes.map((s) => <p class="note mono">* {s.note}</p>)}
</div>

<style>
  .strip {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--panel);
    overflow: hidden;
  }
  .strip div { padding: 16px 18px; border-right: 1px solid var(--line); }
  .strip div:last-child { border-right: 0; }
  dt { font-size: 10px; color: var(--dim); }
  dd { margin-top: 6px; font-size: clamp(22px, 3vw, 28px); }
  .accent { color: var(--amber); }
  .note { margin-top: 8px; font-size: 11px; color: var(--mute); }
  @media (max-width: 640px) {
    .strip { grid-template-columns: 1fr 1fr; }
    .strip div:nth-child(2) { border-right: 0; }
    .strip div:nth-child(-n + 2) { border-bottom: 1px solid var(--line); }
  }
</style>
