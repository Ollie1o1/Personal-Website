---
import { alsoBuilt } from '../data/also-built';
---

<section class="wrap sec" aria-labelledby="also-title">
  <div class="sec-h"><h2 id="also-title">Also built</h2><span>index</span></div>
  <ul class="index">
    {
      alsoBuilt.map((p, i) => (
        <li class="reveal" style={`--i:${i}`}>
          <a href={p.href} target="_blank" rel="noopener">
            <span class="name">
              {p.name} <span class="arrow" aria-hidden="true">↗</span>
            </span>
            <span class="blurb">{p.blurb}</span>
            <span class="lang mono">{p.lang}</span>
          </a>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .index { list-style: none; }
  a {
    display: grid;
    grid-template-columns: minmax(170px, 0.8fr) minmax(0, 2fr) 70px;
    gap: 16px;
    align-items: baseline;
    padding: 13px 0;
    border-bottom: 1px solid var(--line);
    transition: background 150ms;
  }
  .name { font-weight: 600; font-size: 15px; letter-spacing: -0.01em; }
  .arrow { color: var(--dim); font-size: 12px; transition: color 150ms; }
  .blurb { color: var(--body); font-size: 14px; }
  .lang { text-align: right; font-size: 11px; color: var(--mute); }
  a:hover .arrow, a:focus-visible .arrow { color: var(--amber); }
  a:hover .name { color: var(--fg); }
  @media (max-width: 640px) {
    a { grid-template-columns: 1fr auto; gap: 4px 12px; }
    .blurb { grid-column: 1 / -1; grid-row: 2; font-size: 13px; }
  }
</style>
