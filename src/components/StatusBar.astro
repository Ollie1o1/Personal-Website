---
import site from '../site.config';
---

<header class="status">
  <div class="wrap status-inner">
    <a href="/" class="brand" aria-label={`${site.name}, home`}>
      <span class="mark" aria-hidden="true">OR</span>
      <span class="brand-name">{site.name}</span>
    </a>

    <nav aria-label="Primary">
      <a href="/#work" class="nav-link">Work</a>
      <a href="/#experience" class="nav-link">Experience</a>
      <a href={site.resumePath} class="nav-link" target="_blank" rel="noopener">Resume <span aria-hidden="true">↗</span></a>
      <button type="button" class="kbd" data-palette-open aria-haspopup="dialog" aria-label="Open command palette">
        <span data-kbd-label>⌘K</span>
      </button>
    </nav>

    <div class="status-right">
      <span class="clock" aria-hidden="true"><span class="loc">{site.location}</span><time data-clock data-tz={site.timezone}></time></span>
      <button type="button" class="theme-btn" data-theme-toggle aria-label="Toggle color theme">
        <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
          <circle cx="8" cy="8" r="6.25" fill="none" stroke="currentColor" stroke-width="1.25"></circle>
          <path d="M8 1.75a6.25 6.25 0 0 1 0 12.5z" fill="currentColor"></path>
        </svg>
      </button>
    </div>
  </div>
</header>

<style>
  .status {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid var(--line);
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: blur(10px) saturate(140%);
    -webkit-backdrop-filter: blur(10px) saturate(140%);
  }
  .status-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    height: 52px;
    font: 400 12px var(--font-mono);
    color: var(--mute);
  }
  .brand { display: flex; align-items: center; gap: 10px; color: var(--fg); }
  .mark {
    display: inline-grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border: 1px solid var(--fg);
    font: 500 10px var(--font-mono);
    letter-spacing: 0.04em;
  }
  .brand-name { font-family: var(--font-sans); font-size: 14px; font-weight: 500; letter-spacing: -0.01em; }
  nav { display: flex; align-items: center; gap: 22px; }
  .nav-link { transition: color 150ms; }
  .nav-link:hover { color: var(--fg); }
  .kbd {
    border: 1px solid var(--line);
    padding: 2px 7px;
    border-radius: 4px;
    font: 400 11px var(--font-mono);
    color: var(--mute);
    transition: color 150ms, border-color 150ms;
  }
  .kbd:hover { color: var(--fg); border-color: var(--mute); }
  .status-right { display: flex; align-items: center; gap: 14px; }
  .clock time { color: var(--fg); margin-left: 8px; font-variant-numeric: tabular-nums; }
  .clock time:empty { display: none; }
  .theme-btn {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border: 1px solid var(--line);
    border-radius: 4px;
    color: var(--mute);
    transition: color 150ms, border-color 150ms;
  }
  .theme-btn:hover { color: var(--fg); border-color: var(--mute); }

  @media (max-width: 860px) {
    .clock { display: none; }
  }
  @media (max-width: 640px) {
    .brand-name, .nav-link { display: none; }
    nav { margin-left: auto; }
    .nav-link[target] { display: inline; }
    .status-right { gap: 10px; }
  }
</style>
