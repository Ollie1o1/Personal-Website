---
import '@fontsource/inter-tight/400.css';
import '@fontsource/inter-tight/500.css';
import '@fontsource/inter-tight/600.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/tokens.css';
import '../styles/base.css';
import site from '../site.config';
import StatusBar from '../components/StatusBar.astro';
import Footer from '../components/Footer.astro';
import Palette from '../components/Palette.astro';
import { ogPath } from '../lib/og-path';

interface Props {
  title: string;
  description: string;
  /** Site route whose OG card to use; defaults to the current path. */
  ogRoute?: string;
  /** Structured data for this page, emitted as JSON-LD. */
  jsonLd?: Record<string, unknown>;
  noindex?: boolean;
}

const { title, description, ogRoute, jsonLd, noindex = false } = Astro.props;
const base = Astro.site ?? new URL(site.url);
const canonical = new URL(Astro.url.pathname, base);
const ogImage = new URL(ogPath(ogRoute ?? Astro.url.pathname), base);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      (function () {
        var saved = null;
        try { saved = localStorage.getItem('theme'); } catch (e) {}
        var light = window.matchMedia('(prefers-color-scheme: light)').matches;
        document.documentElement.dataset.theme =
          saved === 'light' || saved === 'dark' ? saved : light ? 'light' : 'dark';
        document.documentElement.classList.add('js');
      })();
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#0f1013" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f3f2ee" media="(prefers-color-scheme: light)" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <StatusBar />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <Palette />
    <script>
      import '../scripts/main';
    </script>
  </body>
</html>
